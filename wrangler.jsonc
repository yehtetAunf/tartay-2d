{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tartay-2d",
  "main": "src/index.js",
  "compatibility_date": "2026-07-18",
  "keep_vars": true,
  "minify": true,

  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD2m6Roylj_E5qan"
  },

  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "fb1216ee50624ea79f74f71157e7666d"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ROUND_ALARMS",
        "class_name": "RoundAlarm"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-round-alarm",
      "new_sqlite_classes": ["RoundAlarm"]
    }
  ],

  "triggers": {
    "crons": ["* * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/app",
      "/admin",
      "/history",
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
